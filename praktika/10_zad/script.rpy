define h = Character("Герой")

label start:

    # --- СЦЕНА 1 ---
    scene 1
    with fade
    h "Ещё один раз."
    h "Просто ещё один спин."
    h "Я почти отыгрался…"

    # --- СЦЕНА 2 ---
    scene 2
    h "…Нет."
    h "Да ладно…"
    h "Это невозможно."

    # --- СЦЕНА 3 ---
    scene 3
    h "Сообщение от банка…"
    h "Недостаточно средств."
    h "Чёрт…"

    # --- СЦЕНА 4 ---
    scene 4
    "Мама" "Ты опять не спал?"
    h "Всё нормально."
    "Мама" "Ты выглядишь уставшим."
    h "Я сказал — всё нормально."

    # --- СЦЕНА 5 ---
    scene 5
    "Друг" "Ты снова там сидел?"
    h "Это временно."
    "Друг" "Ты так говорил в прошлый раз."
    h "Я почти выиграл."

    # --- СЦЕНА 6 ---
    scene 6
    h "Они просто не понимают."
    h "Мне нужно ещё немного."
    h "И всё изменится."

    # --- СЦЕНА 7 ---
    scene 7
    h "Вот он шанс."
    h "Сейчас точно повезёт."
    h "Я чувствую."

    # --- ВЫБОР ---
    scene 8
    h "Последние деньги…"

    menu:
        "Поставить всё":
            jump bad_path
        "Остановиться":
            jump good_path


# =========================
# ПЛОХАЯ КОНЦОВКА
# =========================

label bad_path:

    scene 9
    h "Давай…"
    h "Давай…"
    h "ДАВАЙ!"

    scene 10
    h "…"
    h "Нет."
    h "Нет, нет, нет…"

    scene 11
    h "Я всё потерял."
    h "Деньги… время…"
    h "Себя."

    scene 12
    h "И всё равно…"
    h "Я хочу нажать ещё раз."
    h "…ещё один спин."

    return


# =========================
# ХОРОШАЯ КОНЦОВКА
# =========================

label good_path:

    scene 13
    h "…Стоп."
    h "Что я делаю?"
    h "Это не нормально."

    scene 14
    h "Мне нужна помощь."
    "Друг" "Наконец-то."
    h "Я сам не справлюсь."

    scene 15
    h "Это сложно."
    h "Каждый день тянет назад."
    h "Но я держусь."

    scene 16
    h "Я не выиграл деньги."
    h "Но я вернул контроль."
    h "И это важнее."

    return